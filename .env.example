# Server port (Railway sets this automatically)
PORT=3000

# Optional: TURN server credentials for better connectivity behind strict NATs/firewalls
# Get free TURN from services like Twilio, Metered.ca, or self-host coturn
# Example format (do NOT commit real credentials):
# TURN_URL=turn:your-turn-server.example.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# Optional: Force TURN-only mode (more private IP-wise but higher latency/cost)
# FORCE_TURN_ONLY=false
